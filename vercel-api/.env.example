DATABASE_URL=postgresql://user:password@host/db?sslmode=require
APP_ENV=production
# STAGING ONLY: use an independent empty Neon project and privately set its URL.
# These independently approved target guards are required when APP_ENV=staging.
STAGING_DATABASE_HOST=
STAGING_DATABASE_NAME=
STAGING_ENVIRONMENT_ID=
ALLOW_DEMO_OTP=false
# Real verification delivery is required by a production build.
OTPIQ_API_KEY=
# Server-only RevenueCat REST API secret; NEVER a public mobile SDK key.
REVENUECAT_SECRET_API_KEY=
REVENUECAT_ENTITLEMENT_ID=all_feature
SETUP_SECRET=change-me-to-a-long-random-string
ADMIN_SECRET=change-me-to-a-strong-admin-password
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project",...}

# Optional Google AI: SERVER ONLY. Keep disabled until owner approves credentials,
# data-use terms, a spending budget and live staging tests. No key in Flutter.
AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Alternative prepared model: gemini-3.5-flash-lite
# Explicit standard rates required; verify provider pricing when enabling/changing model.
AI_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=
AI_MONTHLY_BUDGET_USD=0
AI_DAILY_REQUEST_LIMIT=10
AI_REQUESTS_PER_MINUTE=3
AI_MAX_INPUT_TOKENS=12000
AI_MAX_OUTPUT_TOKENS=4096
AI_TIMEOUT_MS=25000
AI_CACHE_TTL_SECONDS=21600
